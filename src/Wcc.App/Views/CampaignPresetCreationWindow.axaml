<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wcc.App.ViewModels" xmlns:wccvm="using:Wcc.App.ViewModels.Wcc" xmlns:wml="using:Wcc.Core.Wml" xmlns:local="using:Wcc.App.Views.Controls"
        x:Class="Wcc.App.Views.CampaignPresetCreationWindow" x:DataType="vm:CampaignPresetCreationForm"
        Title="{Binding WindowTitle}" Classes="wccShell" Width="1120" Height="780" MinWidth="720" MinHeight="440" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="{Binding Introduction}" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10">
        <TextBlock Text="Macro name" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" IsReadOnly="{Binding IsNameReadOnly}"/>
        <TextBlock IsVisible="{Binding HasScalarFields}" Grid.Column="2" Text="Difficulty" VerticalAlignment="Center"/>
        <ComboBox IsVisible="{Binding HasScalarFields}" Grid.Column="3" ItemsSource="{Binding ScalarFields.Contexts}" SelectedItem="{Binding ScalarFields.SelectedContext, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate DataType="wml:WmlEvaluationContext"><TextBlock Text="{Binding DifficultyDefine}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      <local:CampaignPresetScopeView/>
      <TextBlock Text="{Binding SourcePath}" Opacity="0.65" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StorageNotice}" Opacity="0.75" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
      <TextBlock Name="ProblemText" TextWrapping="Wrap" Foreground="IndianRed" VerticalAlignment="Center"/>
      <Button IsVisible="{Binding HasScalarFields}" Grid.Column="1" Content="Show / hide fields" local:WccButtonIcon.Action="FieldSettings" ToolTip.Tip="Show or hide preset fields" Click="VisibilityClicked"/>
      <Button Grid.Column="2" Content="{Binding StageLabel}" local:WccButtonIcon.Action="Accept" local:WccButtonIcon.ShowLabel="True" Click="StageClicked"/>
      <Button Grid.Column="3" Content="Cancel" Click="CancelClicked"/>
    </Grid>
    <Grid>
    <StackPanel IsVisible="{Binding !HasScalarFields}" Spacing="14" Margin="0,12">
      <TextBlock Text="{Binding ContentGuidance}" TextWrapping="Wrap"/>
      <Button x:Name="ConfigureUnitPresetButton" Content="Configure unit" local:WccButtonIcon.Action="Edit" local:WccButtonIcon.ShowLabel="True" IsVisible="{Binding IsUnitPreset}" IsEnabled="{Binding CanConfigureContent}" Click="ConfigureUnitClicked" HorizontalAlignment="Left"/>
      <Button x:Name="ConfigureEventPresetButton" Content="Open event editor" local:WccButtonIcon.Action="Edit" local:WccButtonIcon.ShowLabel="True" IsVisible="{Binding IsEventPreset}" IsEnabled="{Binding CanConfigureContent}" Click="ConfigureEventClicked" HorizontalAlignment="Left"/>
      <TextBlock x:Name="PresetContentSummary" Text="{Binding ContentSummary}" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer IsVisible="{Binding HasScalarFields}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding ScalarFields.SideGroups}" IsVisible="{Binding ScalarFields.IsSide}">
          <ItemsControl.ItemTemplate><DataTemplate DataType="vm:WccInitialFieldEditorGroup"><local:WccInitialFieldGroupView/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="{Binding ScalarFields.LeaderColumn}" Grid.ColumnSpan="{Binding ScalarFields.LeaderColumnSpan}" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ScalarFields.IsSide}">
            <Button Content="Add nested leader" local:WccButtonIcon.Action="Add" local:WccButtonIcon.ShowLabel="True" IsEnabled="{Binding ScalarFields.CanAddLeader}" Click="AddLeaderClicked"/>
            <Button Content="Remove selected leader" local:WccButtonIcon.Action="Remove" local:WccButtonIcon.ShowLabel="True" IsEnabled="{Binding ScalarFields.CanRemoveLeader}" Click="RemoveLeaderClicked"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding ScalarFields.Leaders}" SelectedItem="{Binding ScalarFields.SelectedLeader, Mode=TwoWay}" MaxHeight="130">
            <ListBox.ItemTemplate><DataTemplate DataType="wccvm:WccInitialLeaderVm"><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid ColumnDefinitions="*,*" IsVisible="{Binding ScalarFields.HasLeader}">
            <local:WccFieldImagePreviewView DataContext="{Binding ScalarFields.LeaderImagePreview}"/>
            <local:WccFieldImagePreviewView Grid.Column="1" DataContext="{Binding ScalarFields.LeaderPortraitPreview}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding ScalarFields.LeaderGroups}">
            <ItemsControl.ItemTemplate><DataTemplate DataType="vm:WccInitialFieldEditorGroup"><local:WccInitialFieldGroupView/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
