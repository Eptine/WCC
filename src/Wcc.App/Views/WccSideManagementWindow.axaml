<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wcc.App.ViewModels"
        xmlns:icons="using:Wcc.App.Views.Controls"
        x:Class="Wcc.App.Views.WccSideManagementWindow"
        x:DataType="vm:WccSideTopologyManagementVm"
        Title="Edit sides" Classes="wccShell" Width="860" Height="470" MinWidth="730" MinHeight="310"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Guidance}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
      <TextBlock Text="{Binding SelectedRow.Reason}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Add side" icons:WccButtonIcon.Action="Add" icons:WccButtonIcon.ShowLabel="True"
                  Click="AddClicked" IsEnabled="{Binding CanAdd}" ToolTip.Tip="{Binding AddReason}"/>
          <Button Name="AddSideFromPresetButton" Content="Add from preset…" icons:WccButtonIcon.Action="Preset"
                  Click="AddPresetClicked" IsEnabled="{Binding CanAddFromPreset}" ToolTip.Tip="{Binding PresetGuidance}"/>
          <Button Content="Remove" icons:WccButtonIcon.Action="Remove" Click="RemoveClicked"
                  ToolTip.Tip="Remove the selected side" IsEnabled="{Binding CanRemoveSelected}"/>
          <Button Content="Restore" icons:WccButtonIcon.Action="Reset" ToolTip.Tip="Restore the removed side" Click="RestoreClicked" IsEnabled="{Binding CanRestoreSelected}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Close" icons:WccButtonIcon.Action="Close" icons:WccButtonIcon.ShowLabel="True" Click="CloseClicked"/>
      </Grid>
    </StackPanel>
    <Border Classes="panel" Padding="4">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="52,*,150,30" Margin="9,5,9,8">
          <TextBlock Text="Side" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="State" FontWeight="SemiBold"/>
        </Grid>
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:WccSideManagementRowVm">
              <Grid ColumnDefinitions="52,*,150,30" ToolTip.Tip="{Binding Reason}" Margin="3,5">
                <TextBlock Text="{Binding NumberDisplay}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding State}"/>
                <Border Grid.Column="3" IsVisible="{Binding IsMacro}" BorderThickness="1" CornerRadius="5" Padding="3,0">
                  <TextBlock Text="M" HorizontalAlignment="Center"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
