<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcc.App.ViewModels"
             xmlns:controls="using:Wcc.App.Views.Controls"
             x:Class="Wcc.App.Views.Controls.WccSideFlagPresetView"
             x:DataType="vm:ScenarioWindowViewModel">
  <StackPanel Spacing="8">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
      <controls:WccFieldImagePreviewView Grid.Column="0" Grid.RowSpan="2" x:Name="FlagPreview" Width="96" Height="96"/>
      <TextBlock Grid.Column="1" Text="Flag preset" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
      <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding WccSideFlagPresetInvocation, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Top"/>
      <Button Grid.Column="2" Grid.Row="1" Classes="fieldIcon" Content="…" ToolTip.Tip="Choose flag preset" VerticalAlignment="Top"
              controls:WccButtonIcon.Action="Preset" IsEnabled="{Binding CanPickWccSideFlagPreset}" Click="ChooseFlagClicked"/>
    </Grid>
    <TextBlock Text="{Binding WccSideFlagPresetGuidance}" TextWrapping="Wrap" Opacity="0.65"/>
  </StackPanel>
</UserControl>
