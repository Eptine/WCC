<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcc.App.ViewModels" xmlns:icons="using:Wcc.App.Views.Controls"
             x:Class="Wcc.App.Views.Controls.CampaignCreationPackageOptionsView" x:DataType="vm:CampaignCreationViewModel">
  <StackPanel Spacing="10">
    <TextBlock Text="Dependencies" Classes="sectionHeading"/>
    <ListBox ItemsSource="{Binding Dependencies}" SelectedItem="{Binding SelectedCreationDependency, Mode=TwoWay}" MinHeight="100" MaxHeight="260">
      <ListBox.ItemTemplate><DataTemplate DataType="vm:CampaignCreationDependencyRow"><StackPanel Spacing="3"><TextBlock Text="{Binding AddonId}"/><TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Add dependency…" icons:WccButtonIcon.Action="Add" icons:WccButtonIcon.ShowLabel="True" Click="AddDependencyClicked" IsEnabled="{Binding CanConfigureCreationDependencies}"/>
      <Button Content="Edit dependency" icons:WccButtonIcon.Action="Edit" Click="EditDependencyClicked" ToolTip.Tip="Edit the selected dependency draft"/>
      <Button Content="Remove dependency" icons:WccButtonIcon.Action="Remove" Click="RemoveDependencyClicked" ToolTip.Tip="Remove the selected dependency draft"/>
    </StackPanel>
    <TextBlock Text="Source folders are attached to this campaign session after creation. The written loading recipe is portable; it contains no machine folder paths." TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
    <TextBlock Text="{Binding PackageOptionsProblem}" IsVisible="{Binding HasPackageOptionsProblem}" TextWrapping="Wrap" Foreground="IndianRed"/>
  </StackPanel>
</UserControl>
