<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcc.App.ViewModels" x:Class="Wcc.App.Views.Controls.CampaignPresetTypeSelectionView"
             x:DataType="vm:CampaignPresetCreationWizardViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <TextBlock Text="Step 1: Choose a preset type" FontSize="20"/>
    <TextBlock Grid.Row="1" Text="The next step opens its settings. Applying the preset adds it to pending changes for global Save." TextWrapping="Wrap"/>
    <ListBox Grid.Row="2" Name="PresetTypeSelector" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:CampaignPresetTypeChoice">
          <StackPanel Margin="8" Spacing="5">
            <TextBlock Text="{Binding Label}" FontSize="16" Foreground="BurlyWood"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>